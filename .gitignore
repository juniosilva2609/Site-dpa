# Nunca versionar segredos ou certificados
*.pem
*.crt
*.key
*.pfx
*.p12
*.cer
.env
.env.*

__pycache__/
*.pyc
.venv/

# Log de execução do orquestrador (connectors/runner.py) — só nomes de
# banco/status/motivo, nunca segredo, mas não precisa ser versionado.
logs/
.pytest_cache/

# Sistema de NFS-e (nfse/): dados de execução nunca vão para o git
nfse/data/
nfse/saida/
*.db
*.db-wal
*.db-shm
